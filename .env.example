# Copy to .env (never commit .env). Fill in values for your environment.
BOT_REPO=C:\Users\aryan\Desktop\AlgoTrade
SOURCE_DB=C:\Users\aryan\Desktop\AlgoTrade\db\trading_bot.db
# Main cloud database used by the sync tooling. Since Day 4 this is RDS (copy RDS_PG_DSN here);
# the Docker main cloud stays reachable as DOCKER_PG_DSN. Sync only ONE of them from the
# working copy: a sync prunes the shared changelog.
PG_DSN=postgresql://postgres:postgres@localhost:5433/algotrade
DOCKER_PG_DSN=postgresql://postgres:postgres@localhost:5433/algotrade
# Admin DSN used by tests to create/drop throwaway databases
PG_ADMIN_DSN=postgresql://postgres:postgres@localhost:5433/postgres
# AWS RDS (filled by scripts/rds_setup_wizard.sh; never commit real values).
# PG_DSN stays on Docker until RDS is migrated, loaded and reconciled.
AWS_REGION=ap-south-1
RDS_HOST=
RDS_USER=cloudsync_admin
RDS_PASSWORD=
RDS_PG_DSN=
RDS_ADMIN_DSN=
# Database the sync daemon watches (scripts/start_sync_daemon.bat). The working copy by default.
SYNC_SQLITE=data\trading_bot.db
